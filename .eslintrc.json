{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:vue/vue3-essential"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["vue"],
  "rules": {
    "vue/multi-word-component-names": "off",
    "vue/no-unused-vars": "warn",
    "no-unused-vars": "warn",
    "no-console": "warn",
    "no-debugger": "warn"
  },
  "globals": {
    "process": "readonly",
    "console": "readonly",
    "window": "readonly",
    "document": "readonly",
    "localStorage": "readonly",
    "fetch": "readonly",
    "AbortController": "readonly",
    "TextDecoder": "readonly",
    "__dirname": "readonly",
    "require": "readonly",
    "module": "readonly"
  }
} 