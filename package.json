{
  "name": "ai-chat-desktop",
  "version": "1.0.0",
  "description": "A simple AI chat desktop application with custom API key support",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "concurrently \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint src/ --ext .vue,.js,.jsx,.cjs,.mjs --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "build": "vite build",
    "build:electron": "vite build && electron-builder",
    "build:mac": "vite build && electron-builder --mac",
    "build:win": "vite build && electron-builder --win"
  },
  "keywords": [
    "ai",
    "chat",
    "desktop",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/shared": "^3.5.17",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.6.2",
    "dompurify": "^3.2.6",
    "element-plus": "^2.10.4",
    "github-markdown-css": "^5.8.1",
    "highlight.js": "^11.11.1",
    "langchain": "^0.3.6",
    "markdown-it": "^14.1.0",
    "markdown-it-highlightjs": "^4.2.0",
    "ml-distance": "^4.0.1",
    "remixicon": "^4.6.0",
    "sqlite3": "^5.1.7",
    "uuid": "^11.1.0",
    "vite": "^7.0.6",
    "vite-plugin-electron": "^0.29.0",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.3.0",
    "prettier": "^3.0.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.aichat.desktop",
    "productName": "AI Chat Desktop",
    "directories": {
      "output": "dist_electron"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.cjs"
    ]
  }
}
