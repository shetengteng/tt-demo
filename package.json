{
  "name": "ai-chat-desktop",
  "version": "1.0.0",
  "description": "A simple AI chat desktop application with custom API key support",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "concurrently \"vite\" \"wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint src/ --ext .vue,.js,.jsx,.cjs,.mjs --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "keywords": [
    "ai",
    "chat",
    "desktop",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/shared": "^3.5.17",
    "axios": "^1.6.2",
    "dompurify": "^3.2.6",
    "electron": "^28.0.0",
    "element-plus": "^2.10.4",
    "github-markdown-css": "^5.8.1",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-highlightjs": "^4.2.0",
    "remixicon": "^4.6.0",
    "sqlite3": "^5.1.7",
    "uuid": "^11.1.0",
    "vite": "^5.4.19",
    "vite-plugin-electron": "^0.29.0",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^8.0.3",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0"
  }
}
